{
  "//": "The root tsconfig excludes scripts/qa/**, so the E2E suite carries its own typecheck: npx tsc --noEmit -p scripts/qa/e2e/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "Node18",
    "moduleResolution": "node16",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
